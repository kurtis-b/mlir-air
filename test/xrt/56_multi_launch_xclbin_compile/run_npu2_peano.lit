//
// Compile-only: exercises XRTBackend's multi-launch xclbin packaging (the
// doc-29 "4096 wall"), needs aircc/aiecc/peano/xclbinutil but no dispatch.
// Gated on the NPU2 host anyway so it runs where the offload chain builds.
//
// REQUIRES: ryzen_ai_npu2, peano
// RUN: mkdir -p test_peano
// RUN: cd test_peano
// RUN: export PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: %python %S/run.py
