# RUN: %PYTHON %S/gemma3_model_loop.py | FileCheck %s --check-prefix=SESSION
# RUN: rm -rf %t.gemma3_session_cache
# RUN: %PYTHON %S/gemma3_inference.py --compile-only --cache-dir %t.gemma3_session_cache --layers 2 | FileCheck %s --check-prefix=COMPILE
# RUN: %PYTHON %S/gemma3_inference.py --run-only --verify --profile --include-stages --cache-dir %t.gemma3_session_cache --layers 2 --local-window-len 4 --prefill-chunks 2 --decode-tokens 2 | FileCheck %s --check-prefix=EXEC
# SESSION: loop:prefill token_base=0 tokens=4
# SESSION: loop:decode token_base=9 tokens=1
# SESSION: GEMMA3_MODEL_LOOP_SESSION_SELF_TEST: PASS
# COMPILE: GEMMA3_RUNTIME_COMPILE_ONLY: wrote
# EXEC: GEMMA3_RUNTIME_RUN_ONLY: manifest loaded
# EXEC: loop:prefill token_base=0 tokens=4
# EXEC: decode:L0:flowkv status=npu
# EXEC: final_cache_lengths=10,10
# EXEC: GEMMA3_SYNTHETIC_VERIFY: PASS
