# RUN: %PYTHON %S/gemma3_kernel_parity.py --self-test | FileCheck %s
# CHECK: kernel q4nx_smoke_8x4
# CHECK-SAME: mode=l2-gather
# CHECK: kernel flowqkv_paper
# CHECK-SAME: schedule=paper
# CHECK: kernel fused_dqp_pipeline
# CHECK-SAME: class=diagnostic
# CHECK: diagnostic_exclusion kernel=q4nx herd=8x4 mode=direct class=hardware-resource-limit
# CHECK: diagnostic_exclusion kernel=q4nx herd=8x4 mode=packet-direct class=packet-s2mm-backend-limitation
# CHECK: diagnostic_exclusion kernel=flowkv herd=2x4 mode=l2-gather class=channel-runtime-scheduling-bug
# CHECK: GEMMA3_KERNEL_PARITY_MATRIX_SELF_TEST: PASS
