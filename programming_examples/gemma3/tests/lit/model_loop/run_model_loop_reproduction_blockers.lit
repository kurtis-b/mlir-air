# RUN: env GEMMA3_MODEL_ROOT=%t.no_models PYTHONPATH=%S/../../..:%S/../../../../../sandbox/lib/python3.12/site-packages:$PYTHONPATH %PYTHON -m gemma3.evidence.reproduction_blockers --self-test | FileCheck %s
# CHECK: phase F model=gemma3-1b status=BLOCKED blockers=missing-safetensors,missing-config-json,missing-tokenizer
# CHECK: phase G model=gemma3-4b status=BLOCKED blockers=missing-safetensors,missing-config-json,missing-tokenizer
# CHECK: phase H model=gemma3-4b-vision status=BLOCKED blockers=missing-safetensors,missing-config-json,missing-tokenizer,missing-processor
