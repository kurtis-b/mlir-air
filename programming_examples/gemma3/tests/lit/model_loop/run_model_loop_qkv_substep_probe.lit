# RUN: PYTHONPATH=%S/../../..:%S/../../../../../sandbox/lib/python3.12/site-packages:$PYTHONPATH %PYTHON -m gemma3.probes.qkv_substep --self-test | FileCheck %s
# CHECK: qkv_substep_probe model=gemma3-1b status=QKV_SUBSTEP_SEQUENCE_PASS sequence=decode-rmsnorm-qkv phase=decode layer=L0 stages=decode:L0:pre_attention_norm|decode:L0:q_projection|decode:L0:k_projection|decode:L0:v_projection input=1x1152 norm=1x1152 activation=5x256 q_projection=1024 k_projection=256 v_projection=256 output_format=elf bo_binding=runner-owned-persistent-bo norm_tensor=model.layers.0.input_layernorm.weight@0/bo=266240 projection_tensors=q_proj:model.layers.0.self_attn.q_proj.weight|k_proj:model.layers.0.self_attn.k_proj.weight|v_proj:model.layers.0.self_attn.v_proj.weight weight_layout=fused-dqp-paper-repacked-qkv-colblock-loop input_distribution=bounded-uniform-seed0 rms_correlation=0.999991 q_projection_correlation=1.000000 k_projection_correlation=1.000000 v_projection_correlation=1.000000 dense_q_projection_correlation=0.994609 dense_k_projection_correlation=0.995000 dense_v_projection_correlation=0.995500 threshold=0.99 model_runner_gaps=full-layer-not-wired blockers=none
