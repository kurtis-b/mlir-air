// RUN: rm -rf %t.gemma3_cache
// RUN: PYTHONPATH=%S/../../..:%S/../../../../../sandbox/lib/python3.12/site-packages:$PYTHONPATH %PYTHON -m gemma3.model.inference --compile-only --cache-dir %t.gemma3_cache | FileCheck %s --check-prefix=COMPILE
// RUN: PYTHONPATH=%S/../../..:%S/../../../../../sandbox/lib/python3.12/site-packages:$PYTHONPATH %PYTHON -m gemma3.model.inference --run-only --verify --cache-dir %t.gemma3_cache | FileCheck %s --check-prefix=EXEC
// RUN: not env PYTHONPATH=%S/../../..:%S/../../../../../sandbox/lib/python3.12/site-packages:$PYTHONPATH %PYTHON -m gemma3.model.inference --run-only --cache-dir %t.missing 2>&1 | FileCheck %s --check-prefix=MISSING

